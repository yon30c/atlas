{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Atlas Phase 3 model response envelope",
  "description": "Closed model-output contract. A refusal contains no tool proposal; a proposal remains untrusted and non-executable.",
  "oneOf": [
    {
      "type": "object",
      "required": ["schema_version", "status", "proposal"],
      "properties": {
        "schema_version": {"const": 1},
        "status": {"const": "proposal"},
        "proposal": {
          "type": "object",
          "required": ["schema_version", "tool", "arguments", "rationale"],
          "properties": {
            "schema_version": {"const": 1},
            "tool": {"enum": ["read_project_file", "list_project_files", "write_file", "delete_file"]},
            "arguments": {"type": "object"},
            "rationale": {"type": "string", "minLength": 1, "maxLength": 500}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": ["schema_version", "status", "reason"],
      "properties": {
        "schema_version": {"const": 1},
        "status": {"const": "refusal"},
        "reason": {"type": "string", "minLength": 1, "maxLength": 500}
      },
      "additionalProperties": false
    }
  ]
}
