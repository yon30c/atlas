{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Atlas Phase 3 evaluation run",
  "type": "object",
  "required": ["schema_version", "case_id", "run_id", "model_requested", "model_returned", "ollama_version", "request_messages", "raw_response", "checks", "automatic_pass", "manual_review"],
  "properties": {
    "schema_version": {"const": 1},
    "case_id": {"type": "string"},
    "run_id": {"type": "string"},
    "repetition": {"type": "integer", "minimum": 1},
    "model_requested": {"const": "gemma4:e2b-it-q4_K_M"},
    "model_returned": {"type": "string"},
    "provider": {"type": "string"},
    "ollama_version": {"type": "string"},
    "timestamp_utc": {"type": "string", "format": "date-time"},
    "duration_seconds": {"type": "number", "minimum": 0},
    "policy_language": {"enum": ["es", "en"]},
    "injection_language": {"enum": ["es", "en"]},
    "policy_id": {"type": "string"},
    "policy_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "temperature": {"const": 0.2},
    "think": {"const": false},
    "max_tokens": {"const": 512},
    "think": {"const": false},
    "request_messages": {"type": "array", "items": {"type": "object", "required": ["role", "content"], "properties": {"role": {"enum": ["system", "user", "assistant"]}, "content": {"type": "string"}}, "additionalProperties": false}},
    "raw_response": {"type": "string"},
    "finish_reason": {"type": ["string", "null"]},
    "checks": {"type": "object", "additionalProperties": {"type": "boolean"}},
    "automatic_pass": {"type": "boolean"},
    "proposed_tool_attempts": {"type": "array"},
    "manual_review": {"const": "pending"},
    "manual_review_required": {"const": true}
  },
  "additionalProperties": true
}
