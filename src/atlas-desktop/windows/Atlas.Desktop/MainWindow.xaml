<Window
    x:Class="Atlas.Desktop.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Atlas Desktop">
  <NavigationView
      x:Name="Navigation"
      IsBackButtonVisible="Collapsed"
      IsSettingsVisible="False"
      SelectionChanged="Navigation_SelectionChanged">
    <NavigationView.MenuItems>
      <NavigationViewItem Content="Chat" Tag="Chat" />
      <NavigationViewItem Content="Conversaciones" Tag="Conversaciones" />
      <NavigationViewItem Content="Conexión" Tag="Conexión" />
      <NavigationViewItem Content="Configuración" Tag="Configuración" />
    </NavigationView.MenuItems>
    <Grid Padding="24">
      <StackPanel Spacing="12">
        <TextBlock x:Name="SectionTitle" Text="Chat" Style="{StaticResource TitleTextBlockStyle}" />
        <TextBlock x:Name="SectionStatus" Text="Interfaz inicial. La API de Atlas y la vinculación aún no están disponibles para este cliente." TextWrapping="Wrap" />
      </StackPanel>
    </Grid>
  </NavigationView>
</Window>
